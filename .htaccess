# Used only when the hosting document root points at this project folder
# (e.g. the files are uploaded straight into public_html on cPanel).
# Every request is sent into public/, so .env, vendor/, storage/ and the
# source code are never reachable from the web.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
