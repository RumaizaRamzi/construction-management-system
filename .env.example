# =============================================================================
# BuildTrack Laravel API — environment template
# Copy to `.env` and fill in real values for each environment.
# NEVER commit a real `.env` file. NEVER put secrets in VITE_* frontend vars.
# =============================================================================

APP_NAME=BuildTrack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-API-DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=YOUR_DB_HOST
DB_PORT=3306
DB_DATABASE=YOUR_DB_NAME
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@YOUR-DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=YOUR-FRONTEND-DOMAIN,www.YOUR-FRONTEND-DOMAIN
SANCTUM_TOKEN_EXPIRATION=10080

# CORS — comma-separated frontend origins (no wildcard with credentials)
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN,https://www.YOUR-FRONTEND-DOMAIN
CORS_SUPPORTS_CREDENTIALS=false

# React frontend: API URL for the Vite dev server (npm run dev).
# Production builds (npm run build) always call /api on the same domain.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
